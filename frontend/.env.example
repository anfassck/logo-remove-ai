# =================================================================
# CleanFrame AI - Frontend Environment Variables
# Copy this file to .env and configure your values.
# In production (e.g. Vercel), set these in the project environment variables.
# =================================================================

# Backend API Endpoint
# Local Development (leave empty to use Vite proxy /api):
# VITE_API_BASE_URL=/api

# Production (e.g. Render/Railway backend URL):
# VITE_API_BASE_URL=https://your-cleanframe-backend.onrender.com/api
VITE_API_BASE_URL=
