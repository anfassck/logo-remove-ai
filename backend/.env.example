# =================================================================
# CleanFrame AI - Backend Environment Variables
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file with secrets to Git!
# =================================================================

# Server Port
PORT=5005

# Environment (development | production)
NODE_ENV=development

# Storage & Limitation Settings
MAX_FILE_SIZE_MB=50
MAX_VIDEO_DURATION_SEC=180
MAX_CONCURRENT_JOBS=1
FILE_EXPIRY_MINUTES=15

# CORS Allowed Origin (set to your frontend domain in production, e.g. https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# Optional External AI Inpainting Provider (Leave empty for default FFmpeg Delogo)
AI_RESTORATION_API_KEY=
AI_RESTORATION_PROVIDER=
